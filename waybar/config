{
    "layer": "top",
    "position": "top",
    "height": 30,
    
    "modules-left": [
        "niri/workspaces",
        "custom/music"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/drawer",
        "niri/language",
        "cpu",
        "memory",
        "custom/gpu",
        "bluetooth",
        "pulseaudio",
        "network",
        "custom/power"
    ],

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": false
    },
    "clock": {
        "format": "{:%a %d %b, %H:%M}"
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.local/bin/powermenu 2> /dev/null"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "⚠",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip": false,
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e impala > /dev/null 2>&1"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip": true,
        "tooltip-format": "{volume}%",
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e wiremix > /dev/null 2>&1"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth: {status}",
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e bluetui > /dev/null 2>&1"
    },
    "cpu": {
        "interval": 2,
        "format": "  {usage}%",
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30  -e btop"
    },
    "memory": {
        "interval": 2,
        "format": "  {percentage}%", 
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30  -e btop"
    },
    "custom/gpu": {
        "interval": 2,
        "exec": "sh -c 'cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -n 1'",
        "format": "󰢮  {}%",
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30  -e btop"
    },
    "niri/language": {
        "format": "{short}",
        "tooltip": false
    },
    "group/drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": ["custom/arrow", "tray"]
    },
    "custom/arrow": { "format": "", "tooltip": false },
    "custom/music": {
        "format": "{}",
        "return-type": "json",
        "exec": "waybar-module-music",
        "on-click": "playerctl play-pause",
        "escape": false,
        "tooltip": false
    }, 
    "tray": { "icon-size": 18, "spacing": 10 }
}
