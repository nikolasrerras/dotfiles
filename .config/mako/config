font=DepartureMono Nerd Font 16.5

width=420
height=180
anchor=top-right
layer=overlay
outer-margin=8,8,0,0
margin=0,0,8,0
padding=12,16
border-size=2
border-radius=0

icons=1
max-icon-size=42
icon-border-radius=0
markup=1
format=<span alpha="36000">~/notify ❯ %a</span>\n<b>%s</b>\n%b
text-alignment=left

default-timeout=6000
ignore-timeout=1
max-visible=3
group-by=app-name
max-history=0
history=0

on-button-left=invoke-default-action
on-button-right=dismiss

include=~/.config/mako/wallust.conf
include=~/.config/mako/accent.conf

[urgency=low]
default-timeout=4000

[urgency=critical]
default-timeout=0

# grouped and hidden notifications in the same terminal style
[grouped]
format=<span alpha="36000">~/notify ❯ %a (%g)</span>\n<b>%s</b>\n%b

[hidden]
format=<span alpha="36000">~/notify ❯ +%h more</span>

# grouped and hidden notifications in the same terminal style
[grouped]
format=<span alpha="36000">~/notify ❯ %a (%g)</span>\n<b>%s</b>\n%b

[hidden]
format=<span alpha="36000">~/notify ❯ +%h more</span>
