font=Terminess Nerd Font 13.5

width=420
height=160
anchor=top-right
layer=overlay
outer-margin=8,8,0,0
margin=0,0,8,0
padding=10,14
border-size=2
border-radius=0

icons=1
max-icon-size=42
icon-border-radius=2
markup=1
format=<span alpha="36000">[%a]</span> <b>%s</b>\n%b
text-alignment=left

default-timeout=6000
ignore-timeout=1
max-visible=3
group-by=app-name
max-history=0
history=0

on-button-left=invoke-default-action
on-button-right=dismiss

include=~/.config/mako/wallust.conf
include=~/.config/mako/accent.conf

[urgency=low]
default-timeout=4000

[urgency=critical]
default-timeout=0
