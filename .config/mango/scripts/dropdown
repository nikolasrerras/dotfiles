#!/usr/bin/env bash
# Dropdown terminal: toggles a floating kitty attached to a persistent tmux session
# mango version of ~/.local/bin/dropdown: finds the window by its process instead of
# asking the compositor, so it needs no IPC. Closing kitty keeps the tmux session alive.

if pkill -f -- '--class=dropdown'; then
  exit 0
fi
setsid -f kitty --class=dropdown -o remember_window_size=no -o confirm_os_window_close=0 \
  -o initial_window_width=77c -o initial_window_height=18c \
  tmux new-session -A -s dropdown >/dev/null 2>&1
