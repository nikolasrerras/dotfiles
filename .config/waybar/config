{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
    "niri/workspaces",
    "custom/music"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/tray",
    "niri/language",
    "custom/cpu",
    "memory",
    "custom/gpu",
    "bluetooth",
    "pulseaudio",
    "custom/wifi",
    "group/power"
  ],
  "niri/workspaces": {
    "format": "{index}",
    "all-outputs": false
  },
  "custom/music": {
    "exec": "/home/nikolas/.config/waybar/scripts/music.sh",
    "interval": 1,
    "format": "{}",
    "max-length": 45,
    "hide-empty-text": true,
    "escape": true,
    "tooltip": false,
    "on-click": "/home/nikolas/.config/eww/scripts/toggle.sh",
    "on-click-right": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "clock": {
    "format": "{:%a %d %b, %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "format-alt": "{:%A %d %B %Y, %H:%M:%S}",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "mode"
    }
  },
  "custom/power": {
    "format": "",
    "tooltip": true,
    "on-double-click": "systemctl poweroff --no-wall",
    "tooltip-format": "Shutdown: double click · Menu: right click",
    "on-click-right": "~/.local/bin/powermenu 2> /dev/null"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "⚠",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip": true,
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 impala > /dev/null 2>&1",
    "tooltip-format-wifi": "{essid}\nSignal {signalStrength}% ({signaldBm} dBm)\n{frequency} GHz"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip": true,
    "tooltip-format": "{volume}%",
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 wiremix > /dev/null 2>&1",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Bluetooth: {status}",
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 bluetui > /dev/null 2>&1"
  },
  "memory": {
    "interval": 2,
    "format": "  {percentage}%",
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c btop"
  },
  "custom/gpu": {
    "interval": 2,
    "exec": "/home/nikolas/.config/waybar/scripts/gpu.sh",
    "format": "󰢮  {}%",
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c btop",
    "return-type": "json"
  },
  "niri/language": {
    "format": "{short}",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 0
  },
  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "power-child",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/quit",
      "custom/suspend",
      "custom/reboot"
    ]
  },
  "custom/quit": {
    "format": "󰗼",
    "tooltip": true,
    "tooltip-format": "Logout",
    "on-click": "niri msg action quit"
  },
  "custom/suspend": {
    "format": "󰤄",
    "tooltip": true,
    "tooltip-format": "Suspend",
    "on-click": "systemctl suspend"
  },
  "custom/reboot": {
    "format": "󰜉",
    "tooltip": true,
    "tooltip-format": "Restart",
    "on-click": "systemctl reboot --no-wall"
  },
  "custom/cpu": {
    "exec": "/home/nikolas/.config/waybar/scripts/cpu.sh",
    "return-type": "json",
    "interval": 2,
    "format": "  {}%",
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c btop"
  },
  "custom/wifi": {
    "exec": "/home/nikolas/.config/waybar/scripts/wifi.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{icon}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip": true,
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 impala > /dev/null 2>&1"
  },
  "group/tray": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "click-to-reveal": false,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/tray-toggle",
      "tray"
    ]
  },
  "custom/tray-toggle": {
    "format": "",
    "tooltip": false
  }
}
