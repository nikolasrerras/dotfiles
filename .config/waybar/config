{
    "layer": "top",
    "position": "top",
    "height": 30,
    
    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
      "niri/language",
      "cpu",
      "memory",
      "custom/gpu",
      "bluetooth",
      "pulseaudio",
      "network",
      "custom/power"
    ],

   "niri/workspaces": {
    "format": "{index}",
    "all-outputs": false
    },
    "clock": {
        "format": "{:%d %b, %H:%M}"
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.local/bin/powermenu 2> /dev/null"
    },
    "network": {
        "format-wifi": "   ",
        "format-ethernet": " 󰈀  ",
        "format-disconnected": " ⚠ ",
        "tooltip": false,
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e impala > /dev/null 2>&1"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": " 󰖁 ",
        "format-icons": {
            "default": ["  ", "  ", "   "]
        },
        "tooltip": true,
        "tooltip-format": "{volume}%",
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e wiremix > /dev/null 2>&1"
    },
    "bluetooth": {
        "format": "  ",
        "format-disabled": " 󰂲 ",
        "format-connected": " 󰂱 ",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "Connected Devices:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "• {device_alias}",
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e bluetui > /dev/null 2>&1"
    },
    "cpu": {
        "interval": 2,
        "format": "   {usage}% ",
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e btop > /dev/null 2>&1"
    },
    "memory": {
        "interval": 2,
        "format": "   {percentage}% ", 
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e btop > /dev/null 2>&1"
    },
    "custom/gpu": {
        "interval": 2,
        "exec": "sh -c 'cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -n 1'",
        "format": " 󰢮  {}% ",
        "on-click": "ghostty --gtk-single-instance=false --class=com.floating.tui --window-width=90 --window-height=30 --window-padding-x=0 --window-padding-y=0 -e btop > /dev/null 2>&1"
    },
    "niri/language": {
        "format": "{short}",
        "tooltip": false
    }

} 
