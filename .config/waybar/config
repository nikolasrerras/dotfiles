{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
    "niri/workspaces",
    "custom/music"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/tray",
    "niri/language",
    "custom/cpu",
    "memory",
    "custom/gpu",
    "bluetooth",
    "pulseaudio",
    "custom/wifi",
    "group/power"
  ],
  "niri/workspaces": {
    "format": "{index}",
    "all-outputs": false
  },
  "custom/music": {
    "exec": "/home/nikolas/.config/waybar/scripts/music.sh",
    "interval": 1,
    "format": "<span alpha=\"55%\">[</span>{}<span alpha=\"55%\">]</span>",
    "hide-empty-text": true,
    "escape": true,
    "tooltip": false,
    "on-click": "/home/nikolas/.config/eww/scripts/toggle.sh",
    "on-click-right": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%A %d %B %Y, %H:%M:%S}",
    "interval": 1,
    "on-click-right": "/home/nikolas/.config/eww/scripts/popup.sh calendar",
    "tooltip": false
  },
  "custom/power": {
    "format": "<span alpha=\"55%\">[</span> <span size=\"larger\">󰐥</span> <span alpha=\"55%\">]</span>",
    "tooltip": true,
    "on-double-click": "systemctl poweroff --no-wall",
    "tooltip-format": "Shutdown: double click · Menu: right click",
    "on-click-right": "~/.local/bin/powermenu 2> /dev/null"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "⚠",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip": true,
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 impala > /dev/null 2>&1",
    "tooltip-format-wifi": "{essid}\nSignal {signalStrength}% ({signaldBm} dBm)\n{frequency} GHz"
  },
  "pulseaudio": {
    "format": "<span alpha=\"55%\">[</span><span alpha=\"55%\">{icon}</span> {volume}%<span alpha=\"55%\">]</span>",
    "format-muted": "<span alpha=\"55%\">[</span><span alpha=\"55%\">󰝟</span> mute<span alpha=\"55%\">]</span>",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip": true,
    "tooltip-format": "{volume}%",
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 wiremix > /dev/null 2>&1",
    "on-scroll-up": "/home/nikolas/.config/eww/scripts/volume.sh up",
    "on-scroll-down": "/home/nikolas/.config/eww/scripts/volume.sh down",
    "on-click-right": "/home/nikolas/.config/eww/scripts/volume.sh mute"
  },
  "bluetooth": {
    "format": "<span alpha=\"55%\">[</span><span alpha=\"55%\">󰂯</span> on<span alpha=\"55%\">]</span>",
    "format-disabled": "<span alpha=\"55%\">[</span><span alpha=\"55%\">󰂲</span> off<span alpha=\"55%\">]</span>",
    "format-connected": "<span alpha=\"55%\">[</span><span alpha=\"55%\">󰂱</span> {num_connections}<span alpha=\"55%\">]</span>",
    "tooltip-format": "Bluetooth: {status}",
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 bluetui > /dev/null 2>&1",
    "format-off": "<span alpha=\"55%\">[</span><span alpha=\"55%\">󰂲</span> off<span alpha=\"55%\">]</span>"
  },
  "memory": {
    "interval": 2,
    "format": "<span alpha=\"55%\">[</span><span alpha=\"55%\">󰍛</span> {percentage}%<span alpha=\"55%\">]</span>",
    "on-click": "/home/nikolas/.config/eww/scripts/popup.sh system",
    "on-click-right": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c btop"
  },
  "custom/gpu": {
    "interval": 2,
    "exec": "/home/nikolas/.config/waybar/scripts/gpu.sh",
    "format": "<span alpha=\"55%\">[</span><span alpha=\"55%\">󰢮</span> {}%<span alpha=\"55%\">]</span>",
    "on-click": "/home/nikolas/.config/eww/scripts/popup.sh system",
    "return-type": "json",
    "on-click-right": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c btop"
  },
  "niri/language": {
    "format": "<span alpha=\"55%\">[</span><span alpha=\"55%\">󰌌</span> {short}<span alpha=\"55%\">]</span>",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 0
  },
  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "power-child",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/quit",
      "custom/suspend",
      "custom/reboot"
    ]
  },
  "custom/quit": {
    "format": "<span alpha=\"55%\">[</span>󰗼<span alpha=\"55%\">]</span>",
    "tooltip": true,
    "tooltip-format": "Logout",
    "on-click": "niri msg action quit"
  },
  "custom/suspend": {
    "format": "<span alpha=\"55%\">[</span>󰤄<span alpha=\"55%\">]</span>",
    "tooltip": true,
    "tooltip-format": "Suspend",
    "on-click": "systemctl suspend"
  },
  "custom/reboot": {
    "format": "<span alpha=\"55%\">[</span>󰜉<span alpha=\"55%\">]</span>",
    "tooltip": true,
    "tooltip-format": "Restart",
    "on-click": "systemctl reboot --no-wall"
  },
  "custom/cpu": {
    "exec": "/home/nikolas/.config/waybar/scripts/cpu.sh",
    "return-type": "json",
    "interval": 2,
    "format": "<span alpha=\"55%\">[</span><span alpha=\"55%\"></span> {}%<span alpha=\"55%\">]</span>",
    "on-click": "/home/nikolas/.config/eww/scripts/popup.sh system",
    "on-click-right": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c btop"
  },
  "custom/wifi": {
    "exec": "/home/nikolas/.config/waybar/scripts/wifi.sh",
    "return-type": "json",
    "interval": 5,
    "format": "<span alpha=\"55%\">[</span><span alpha=\"55%\">{icon}</span> {percentage}%<span alpha=\"55%\">]</span>",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip": true,
    "on-click": "kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 impala > /dev/null 2>&1"
  },
  "custom/tray-l": {
    "format": "<span alpha=\"55%\">[</span>",
    "tooltip": false
  },
  "custom/tray-r": {
    "format": "<span alpha=\"55%\">]</span>",
    "tooltip": false
  },
  "group/tray": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "click-to-reveal": true,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/tray-toggle",
      "custom/tray-l",
      "tray",
      "custom/tray-r"
    ]
  },
  "custom/tray-toggle": {
    "format": "<span alpha=\"55%\">[</span>&lt;<span alpha=\"55%\">]</span>",
    "tooltip": false
  }
}
