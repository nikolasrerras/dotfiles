;; ─────────────────────────────────────────────
;;  Media player popup, terminal style
;;  (opened from the waybar music module)
;; ─────────────────────────────────────────────

(deflisten media
  :initial '{"status":"Stopped","title":"","artist":"","album":"","art":"","length":0}'
  "~/.config/eww/scripts/media.sh")

(defpoll bar :interval "1s" :initial "00:00 ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░ 00:00"
  "~/.config/eww/scripts/bar.sh 30")
(defpoll loop :interval "1s" :initial "None"
  "playerctl loop 2>/dev/null || echo None")
(defpoll shuffle :interval "1s" :initial "Off"
  "playerctl shuffle 2>/dev/null || echo Off")

(defvar media_inside false)
(defvar media_token "0")

(defwidget row [key value ?cls]
  (box :orientation "h" :space-evenly false
    (label :class "key" :xalign 0 :text key)
    (label :class "val ${cls}" :xalign 0 :limit-width 24 :text value)))

(defwidget media-player []
  (box :class "player" :orientation "v" :space-evenly false
    (box :class "header" :orientation "h" :space-evenly false
      (label :class "prompt" :xalign 0 :hexpand true
             :text "~/music ❯ ${media.status == 'Playing' ? 'playing' : (media.status == 'Paused' ? 'paused' : 'stopped')}")
      )
    (box :class "top" :orientation "h" :space-evenly false :spacing 14
      (box :class "art" :width 110 :height 110
           :style {media.art != "" ? "background-image: url('${media.art}');" : ""}
        (label :class "art-placeholder" :visible {media.art == ""} :text "󰝚"))
      (box :class "info" :orientation "v" :space-evenly false :valign "center" :hexpand true :spacing 4
        (row :key "title  " :value {media.title != "" ? media.title : "nothing playing"} :cls "title")
        (row :key "artist " :value {media.artist != "" ? media.artist : "-"} :cls "artist")
        (row :key "album  " :value {media.album != "" ? media.album : "-"} :cls "album")))
    (label :class "bar" :xalign 0 :text bar)
    (box :class "controls media-controls" :orientation "h" :space-evenly true
      (button :class {shuffle == "On" ? "btn active" : "btn"}
              :onclick {shuffle == "On" ? "playerctl shuffle Off" : "playerctl shuffle On"} "󰒝")
      (button :class "btn" :onclick "playerctl previous" "󰒮")
      (button :class "btn" :onclick "playerctl play-pause"
              {media.status == "Playing" ? "󰏤" : "󰐊"})
      (button :class "btn" :onclick "playerctl next" "󰒭")
      (button :class {loop != "None" ? "btn active" : "btn"}
              :onclick "~/.config/eww/scripts/loop.sh"
              {loop == "Track" ? "󰑘" : (loop == "Playlist" ? "󰑖" : "󰑗")}))))

(defwindow media
  :monitor 0
  :geometry (geometry :x "-120px" :y "6px" :width "420px" :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (eventbox :onhover "eww update media_inside=true"
            :onhoverlost "setsid -f ~/.config/eww/scripts/close-later.sh"
    (media-player)))

;; ─────────────────────────────────────────────
;;  Volume OSD, terminal style (scripts/volume.sh)
;; ─────────────────────────────────────────────
(defvar osd_text "")
(defvar osd_token "0")

(defwidget osd []
  (box :class "osd"
    (label :class "osd-text" :text osd_text)))

(defwindow osd
  :monitor 0
  :geometry (geometry :y "80px" :width "480px" :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (osd))

;; ─────────────────────────────────────────────
;;  Calendar and system popups (scripts/popup.sh)
;; ─────────────────────────────────────────────
(defvar calendar_inside false)
(defvar calendar_token "0")
(defvar system_inside false)
(defvar system_token "0")

(defvar cal_off 0)
(defvar cal_title "")
(defvar cal_text "")
(defvar sys_text "")

(defpoll sys_poll :interval "2s" :run-while {system_inside}
  "~/.config/eww/scripts/sys.sh")

(defwidget calendar-popup []
  (box :class "player" :orientation "v" :space-evenly false
    (label :class "prompt" :xalign 0 :text "~/calendar ❯ ${cal_title}")
    (label :class "cal" :xalign 0.5 :justify "left" :markup cal_text)
    (box :class "controls" :orientation "h" :space-evenly true
      (button :class "btn" :onclick "~/.config/eww/scripts/cal.sh prev" "<")
      (button :class "btn" :onclick "~/.config/eww/scripts/cal.sh today" "today")
      (button :class "btn" :onclick "~/.config/eww/scripts/cal.sh next" ">"))))

(defwidget system-popup []
  (box :class "player" :orientation "v" :space-evenly false
    (label :class "prompt" :xalign 0 :text "~/system ❯ status")
    (label :class "sys" :xalign 0 :markup {sys_poll != "" ? sys_poll : sys_text})))

(defwindow calendar
  :monitor 0
  :geometry (geometry :y "6px" :width "300px" :anchor "top center")
  :stacking "overlay" :exclusive false :focusable false
  (eventbox :onhover "eww update calendar_inside=true"
            :onhoverlost "setsid -f ~/.config/eww/scripts/close-later.sh calendar"
    (calendar-popup)))

(defwindow system
  :monitor 0
  :geometry (geometry :x "6px" :y "6px" :width "440px" :anchor "top right")
  :stacking "overlay" :exclusive false :focusable false
  (eventbox :onhover "eww update system_inside=true"
            :onhoverlost "setsid -f ~/.config/eww/scripts/close-later.sh system"
    (system-popup)))

;; ─────────────────────────────────────────────
;;  Power popup (scripts/popup.sh power)
;; ─────────────────────────────────────────────
(defvar power_inside false)
(defvar power_token "0")
(defvar power_confirm "")
(defvar power_uptime "")

(defwidget power-popup []
  (box :class "player power" :orientation "v" :space-evenly false
    (label :class "prompt" :xalign 0 :text "~/power ❯ up ${power_uptime}")
    (box :class "controls" :orientation "v" :space-evenly false :spacing 4
      (button :class {power_confirm == "logout" ? "btn active" : "btn"}
              :onclick {power_confirm == "logout" ? "niri msg action quit --skip-confirmation" : "eww update power_confirm=logout"}
              (label :xalign 0 :text {power_confirm == "logout" ? "󰗼 sure?" : "󰗼 logout"}))
      (button :class "btn" :onclick "eww close power; systemctl suspend" (label :xalign 0 :text "󰤄 suspend"))
      (button :class {power_confirm == "restart" ? "btn active" : "btn"}
              :onclick {power_confirm == "restart" ? "systemctl reboot" : "eww update power_confirm=restart"}
              (label :xalign 0 :text {power_confirm == "restart" ? "󰜉 sure?" : "󰜉 restart"}))
      (button :class {power_confirm == "shutdown" ? "btn active" : "btn"}
              :onclick {power_confirm == "shutdown" ? "systemctl poweroff" : "eww update power_confirm=shutdown"}
              (label :xalign 0 :text {power_confirm == "shutdown" ? "󰐥 sure?" : "󰐥 shutdown"})))))

(defwindow power
  :monitor 0
  :geometry (geometry :x "6px" :y "6px" :width "260px" :anchor "top right")
  :stacking "overlay" :exclusive false :focusable false
  (eventbox :onhover "eww update power_inside=true"
            :onhoverlost "setsid -f ~/.config/eww/scripts/close-later.sh power"
    (power-popup)))

;; ─────────────────────────────────────────────
;;  Audio popup (scripts/popup.sh audio)
;; ─────────────────────────────────────────────
(defvar audio_inside false)
(defvar audio_token "0")
(defvar audio '{"vol":0,"muted":false,"mic":0,"mic_muted":false,"sinks":[]}')

(defwidget audio-row [key value muted onchange onmute icon]
  (box :class "audio-row" :orientation "h" :space-evenly false :spacing 10
    (label :class "key" :xalign 0 :text key)
    (scale :class "slider" :hexpand true :min 0 :max 101 :value value :onchange onchange)
    (label :class "val" :width 40 :xalign 1 :text {muted ? "mute" : "${value}%"})
    (button :class {muted ? "btn active" : "btn"} :onclick onmute icon)))

(defwidget audio-popup []
  (box :class "player" :orientation "v" :space-evenly false
    (label :class "prompt" :xalign 0
           :text "~/audio ❯ ${audio.muted ? 'muted' : audio.vol + '%'}")
    (box :class "audio-levels" :orientation "v" :space-evenly false :spacing 6
      (audio-row :key "out" :value {audio.vol} :muted {audio.muted}
                 :onchange "setsid -f ~/.config/eww/scripts/audio.sh set {}"
                 :onmute "setsid -f ~/.config/eww/scripts/audio.sh mute"
                 :icon {audio.muted ? "󰝟" : "󰕾"})
      (audio-row :key "mic" :value {audio.mic} :muted {audio.mic_muted}
                 :onchange "setsid -f ~/.config/eww/scripts/audio.sh mic {}"
                 :onmute "setsid -f ~/.config/eww/scripts/audio.sh mic-mute"
                 :icon {audio.mic_muted ? "󰍭" : "󰍬"}))
    (label :class "key audio-title" :xalign 0 :text "output")
    (box :orientation "v" :space-evenly false
      (for s in {audio.sinks}
        (button :class {s.default ? "btn active" : "btn"}
                :onclick "setsid -f ~/.config/eww/scripts/audio.sh sink ${s.name}"
          (label :xalign 0 :limit-width 42 :text "${s.default ? '●' : '○'} ${s.desc}"))))
    (box :class "controls" :orientation "h" :space-evenly true
      (button :class "btn"
              :onclick "eww close audio; setsid -f kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 wiremix >/dev/null 2>&1"
              "mixer"))))

(defwindow audio
  :monitor 0
  :geometry (geometry :x "6px" :y "6px" :width "400px" :anchor "top right")
  :stacking "overlay" :exclusive false :focusable false
  (eventbox :onhover "eww update audio_inside=true"
            :onhoverlost "setsid -f ~/.config/eww/scripts/close-later.sh audio"
    (audio-popup)))

;; ─────────────────────────────────────────────
;;  Wifi popup (scripts/popup.sh wifi)
;; ─────────────────────────────────────────────
(defvar wifi_inside false)
(defvar wifi_token "0")
(defvar wifi '{"powered":false,"state":"off","ssid":"","ip":"","networks":[]}')

(defwidget wifi-popup []
  (box :class "player" :orientation "v" :space-evenly false
    (label :class "prompt" :xalign 0
           :text "~/wifi ❯ ${!wifi.powered ? 'off' : (wifi.ssid != '' ? wifi.ssid : wifi.state)}")
    (box :class "wifi-info" :orientation "v" :space-evenly false :visible {wifi.ssid != ""}
      (row :key "ip     " :value {wifi.ip != "" ? wifi.ip : "-"}))
    (label :class "key wifi-title" :xalign 0 :visible {wifi.powered} :text "networks")
    (box :orientation "v" :space-evenly false :visible {wifi.powered}
      (for n in {wifi.networks}
        (button :class {n.connected ? "btn active" : "btn"}
                :onclick "setsid -f ~/.config/eww/scripts/wifi.sh connect ${n.b64}"
          (label :xalign 0 :limit-width 40
                 :text "${n.icon} ${n.name}${n.secure && !n.known ? '  󰌾' : ''}"))))
    (box :class "controls" :orientation "h" :space-evenly false :spacing 14 :halign "center"
      (button :class "btn" :onclick "setsid -f ~/.config/eww/scripts/wifi.sh scan" "scan")
      (button :class {wifi.powered ? "btn" : "btn active"}
              :onclick "setsid -f ~/.config/eww/scripts/wifi.sh power"
              {wifi.powered ? "off" : "on"})
      (button :class "btn" :visible {wifi.ssid != ""}
              :onclick "setsid -f ~/.config/eww/scripts/wifi.sh disconnect" "disconnect")
      (button :class "btn"
              :onclick "eww close wifi; setsid -f kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 impala >/dev/null 2>&1"
              "impala"))))

(defwindow wifi
  :monitor 0
  :geometry (geometry :x "6px" :y "6px" :width "440px" :anchor "top right")
  :stacking "overlay" :exclusive false :focusable false
  (eventbox :onhover "eww update wifi_inside=true"
            :onhoverlost "setsid -f ~/.config/eww/scripts/close-later.sh wifi"
    (wifi-popup)))

;; ─────────────────────────────────────────────
;;  Bluetooth popup (scripts/popup.sh bluetooth)
;; ─────────────────────────────────────────────
(defvar bluetooth_inside false)
(defvar bluetooth_token "0")
(defvar bluetooth '{"powered":false,"connected":0,"devices":[]}')

(defwidget bluetooth-popup []
  (box :class "player" :orientation "v" :space-evenly false
    (label :class "prompt" :xalign 0
           :text "~/bluetooth ❯ ${bluetooth.powered ? 'on' : 'off'}")
    (label :class "key bt-title" :xalign 0 :visible {bluetooth.powered}
           :text {arraylength(bluetooth.devices) > 0 ? "devices" : "no paired devices"})
    (box :orientation "v" :space-evenly false :visible {bluetooth.powered}
      (for d in {bluetooth.devices}
        (button :class {d.connected ? "btn active" : "btn"}
                :onclick "setsid -f ~/.config/eww/scripts/bluetooth.sh toggle ${d.mac}"
          (label :xalign 0 :limit-width 40
                 :text "${d.icon} ${d.name}${d.battery != '' ? '  ' + d.battery + '%' : ''}"))))
    (box :class "controls" :orientation "h" :space-evenly false :spacing 14 :halign "center"
      (button :class {bluetooth.powered ? "btn" : "btn active"}
              :onclick "setsid -f ~/.config/eww/scripts/bluetooth.sh power"
              {bluetooth.powered ? "off" : "on"})
      (button :class "btn" :visible {bluetooth.connected > 0}
              :onclick "setsid -f ~/.config/eww/scripts/bluetooth.sh disconnect" "disconnect")
      (button :class "btn"
              :onclick "eww close bluetooth; setsid -f kitty --class=com.floating.tui -o remember_window_size=no -o initial_window_width=90c -o initial_window_height=30c -o window_padding_width=0 bluetui >/dev/null 2>&1"
              "bluetui"))))

(defwindow bluetooth
  :monitor 0
  :geometry (geometry :x "6px" :y "6px" :width "380px" :anchor "top right")
  :stacking "overlay" :exclusive false :focusable false
  (eventbox :onhover "eww update bluetooth_inside=true"
            :onhoverlost "setsid -f ~/.config/eww/scripts/close-later.sh bluetooth"
    (bluetooth-popup)))
