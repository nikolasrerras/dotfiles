[Unit]
Description=restic backup of home to /mnt/hdd
RequiresMountsFor=/mnt/hdd

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
Environment=RESTIC_REPOSITORY=/mnt/hdd/backup/restic
Environment=RESTIC_PASSWORD_FILE=%h/.config/restic/password
ExecStart=/usr/bin/restic backup %h --exclude-file=%h/.config/restic/excludes --exclude-caches --quiet
ExecStartPost=/usr/bin/restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune --quiet
