{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "TempleOS", "padding": { "top": 1, "right": 4 } },
  "display": {
    "separator": " ",
    "key": { "width": 9 },
    "color": { "title": "cyan" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "{#36}── system ─────────────────────" },
    { "type": "os", "key": "os", "keyColor": "red" },
    { "type": "kernel", "key": "kernel", "keyColor": "green" },
    { "type": "wm", "key": "wm", "keyColor": "yellow" },
    { "type": "shell", "key": "shell", "keyColor": "blue" },
    { "type": "terminal", "key": "term", "keyColor": "magenta" },
    { "type": "custom", "format": "{#36}── hardware ───────────────────" },
    { "type": "cpu", "key": "cpu", "keyColor": "red", "format": "{name} @ {freq-max}" },
    { "type": "gpu", "key": "gpu", "keyColor": "green", "format": "{name}" },
    { "type": "memory", "key": "memory", "keyColor": "yellow" },
    { "type": "disk", "key": "disk", "keyColor": "blue", "folders": "/" },
    { "type": "custom", "format": "{#36}── now ────────────────────────" },
    { "type": "media", "key": "music", "keyColor": "magenta", "format": "{title} — {artist}" },
    { "type": "uptime", "key": "uptime", "keyColor": "red" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
