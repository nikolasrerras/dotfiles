configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "JetBrainsMono Nerd Font 12";
    bg: #1F1F28;
    fg: #DCD7BA;
    accent: #C0A36E;
    header-bg: #1F1F28;
    muted: #727169;
}

window {
    width: 350px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 4px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    padding: 0px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @header-bg;
    padding: 10px 16px;
    border: 0px 0px 1px 0px;
    border-color: @muted;
    children: [ prompt ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

listview {
    background-color: transparent;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    lines: 5;
    spacing: 0px;
    padding: 5px 0px 5px 0px;

}
element {
    background-color: transparent;
    text-color: @fg;
    padding: 8px 16px;
    spacing: 20px;
    border-radius: 0px;

}
element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

entry { enabled: false; }
