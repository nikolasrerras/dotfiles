{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Wallust",
  "author": "wallust template",
  "themes": [
    {
      "name": "Wallust",
      "appearance": "dark",
      "style": {
        "background": "{{background}}",
        "surface.background": "{{background}}",
        "elevated_surface.background": "{{background}}",
        "panel.background": "{{background}}",
        "editor.background": "{{background}}",
        "editor.gutter.background": "{{background}}",
        "editor.subheader.background": "{{background}}",
        "title_bar.background": "{{background}}",
        "title_bar.inactive_background": "{{background}}",
        "status_bar.background": "{{background}}",
        "toolbar.background": "{{background}}",
        "tab_bar.background": "{{background}}",
        "tab.active_background": "{{color8}}40",
        "tab.inactive_background": "{{background}}",
        "terminal.background": "{{background}}",

        "border": "{{color8}}",
        "border.variant": "{{color8}}80",
        "border.focused": "{{color4}}",
        "border.selected": "{{color4}}",
        "border.transparent": "#00000000",
        "border.disabled": "{{color8}}60",
        "pane.focused_border": "{{color4}}",
        "pane_group.border": "{{color8}}",

        "element.background": "{{color8}}30",
        "element.hover": "{{color8}}50",
        "element.active": "{{color8}}70",
        "element.selected": "{{color8}}60",
        "element.disabled": "{{color8}}20",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{color8}}50",
        "ghost_element.active": "{{color8}}70",
        "ghost_element.selected": "{{color8}}60",
        "drop_target.background": "{{color4}}30",

        "text": "{{foreground}}",
        "text.muted": "{{color7}}",
        "text.placeholder": "{{color8}}",
        "text.disabled": "{{color8}}",
        "text.accent": "{{color4}}",
        "icon": "{{foreground}}",
        "icon.muted": "{{color7}}",
        "icon.disabled": "{{color8}}",
        "icon.placeholder": "{{color8}}",
        "icon.accent": "{{color4}}",

        "editor.foreground": "{{foreground}}",
        "editor.line_number": "{{color8}}",
        "editor.active_line_number": "{{foreground}}",
        "editor.active_line.background": "{{color8}}25",
        "editor.highlighted_line.background": "{{color8}}35",
        "editor.indent_guide": "{{color8}}40",
        "editor.indent_guide_active": "{{color8}}",
        "editor.wrap_guide": "{{color8}}40",
        "editor.active_wrap_guide": "{{color8}}80",
        "editor.document_highlight.read_background": "{{color4}}25",
        "editor.document_highlight.write_background": "{{color4}}35",
        "search.match_background": "{{color3}}40",
        "scrollbar.thumb.background": "{{color8}}60",
        "scrollbar.thumb.hover_background": "{{color8}}",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "link_text.hover": "{{color4}}",

        "error": "{{color1}}",
        "error.background": "{{color1}}20",
        "error.border": "{{color1}}",
        "warning": "{{color3}}",
        "warning.background": "{{color3}}20",
        "warning.border": "{{color3}}",
        "success": "{{color2}}",
        "success.background": "{{color2}}20",
        "success.border": "{{color2}}",
        "info": "{{color4}}",
        "info.background": "{{color4}}20",
        "info.border": "{{color4}}",
        "hint": "{{color6}}",
        "hint.background": "{{color6}}20",
        "hint.border": "{{color6}}",
        "created": "{{color2}}",
        "created.background": "{{color2}}20",
        "modified": "{{color3}}",
        "modified.background": "{{color3}}20",
        "deleted": "{{color1}}",
        "deleted.background": "{{color1}}20",
        "conflict": "{{color5}}",
        "ignored": "{{color8}}",
        "hidden": "{{color8}}",

        "terminal.foreground": "{{foreground}}",
        "terminal.bright_foreground": "{{color15}}",
        "terminal.dim_foreground": "{{color7}}",
        "terminal.ansi.black": "{{color0}}",
        "terminal.ansi.red": "{{color1}}",
        "terminal.ansi.green": "{{color2}}",
        "terminal.ansi.yellow": "{{color3}}",
        "terminal.ansi.blue": "{{color4}}",
        "terminal.ansi.magenta": "{{color5}}",
        "terminal.ansi.cyan": "{{color6}}",
        "terminal.ansi.white": "{{color7}}",
        "terminal.ansi.bright_black": "{{color8}}",
        "terminal.ansi.bright_red": "{{color9}}",
        "terminal.ansi.bright_green": "{{color10}}",
        "terminal.ansi.bright_yellow": "{{color11}}",
        "terminal.ansi.bright_blue": "{{color12}}",
        "terminal.ansi.bright_magenta": "{{color13}}",
        "terminal.ansi.bright_cyan": "{{color14}}",
        "terminal.ansi.bright_white": "{{color15}}",

        "players": [
          { "cursor": "{{color4}}", "background": "{{color4}}", "selection": "{{color4}}40" },
          { "cursor": "{{color5}}", "background": "{{color5}}", "selection": "{{color5}}40" },
          { "cursor": "{{color2}}", "background": "{{color2}}", "selection": "{{color2}}40" },
          { "cursor": "{{color3}}", "background": "{{color3}}", "selection": "{{color3}}40" }
        ],

        "syntax": {
          "comment": { "color": "{{color8}}", "font_style": "italic" },
          "comment.doc": { "color": "{{color8}}", "font_style": "italic" },
          "keyword": { "color": "{{color5}}" },
          "string": { "color": "{{color2}}" },
          "string.escape": { "color": "{{color6}}" },
          "string.regex": { "color": "{{color6}}" },
          "string.special": { "color": "{{color6}}" },
          "number": { "color": "{{color3}}" },
          "boolean": { "color": "{{color3}}" },
          "constant": { "color": "{{color3}}" },
          "function": { "color": "{{color4}}" },
          "constructor": { "color": "{{color4}}" },
          "type": { "color": "{{color6}}" },
          "variable": { "color": "{{foreground}}" },
          "variable.special": { "color": "{{color1}}" },
          "property": { "color": "{{color4}}" },
          "attribute": { "color": "{{color3}}" },
          "tag": { "color": "{{color1}}" },
          "operator": { "color": "{{color6}}" },
          "punctuation": { "color": "{{color7}}" },
          "punctuation.bracket": { "color": "{{color7}}" },
          "punctuation.delimiter": { "color": "{{color7}}" },
          "label": { "color": "{{color4}}" },
          "title": { "color": "{{color4}}", "font_weight": 700 },
          "emphasis": { "color": "{{color5}}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{color3}}", "font_weight": 700 },
          "link_text": { "color": "{{color4}}" },
          "link_uri": { "color": "{{color6}}" },
          "embedded": { "color": "{{foreground}}" },
          "preproc": { "color": "{{color5}}" },
          "enum": { "color": "{{color6}}" },
          "variant": { "color": "{{color6}}" }
        }
      }
    }
  ]
}
