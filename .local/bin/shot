#!/usr/bin/env bash
# shot — screenshot → satty (annotate, then Ctrl+C to copy / Ctrl+S to save)
#
#   shot region   select an area with the mouse (default)
#   shot screen   the whole focused monitor
#   shot window   the focused window

set -o pipefail
source "$HOME/.cache/wallust/colors.sh" 2>/dev/null

tmp=$(mktemp --suffix=.png)
trap 'rm -f "$tmp"' EXIT

case ${1:-region} in
  region)
    geo=$(slurp -d -w 2 -b "${background:-#000000}66" -c "${color4:-#ffffff}ff" -s "#00000000") || exit 0
    grim -g "$geo" "$tmp" || exit 1
    ;;
  screen)
    out=$(niri msg -j focused-output | jq -r .name)
    grim -o "$out" "$tmp" || exit 1
    ;;
  window)
    # let niri capture the window itself (it knows where tiled windows are),
    # then pick up the saved file from niri's event stream
    ev=$(mktemp)
    niri msg -j event-stream >"$ev" 2>/dev/null &
    pid=$!
    sleep 0.2
    niri msg action screenshot-window >/dev/null 2>&1
    path=""
    for _ in $(seq 50); do
      path=$(jq -r 'select(.ScreenshotCaptured?) | .ScreenshotCaptured.path // empty' "$ev" 2>/dev/null | head -n1)
      [[ -n $path ]] && break
      sleep 0.1
    done
    kill "$pid" 2>/dev/null
    rm -f "$ev"
    [[ -f $path ]] || exit 1
    mv "$path" "$tmp"           # satty decides where (and whether) to save it
    ;;
  *)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

satty --filename "$tmp"
