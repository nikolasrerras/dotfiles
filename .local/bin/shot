#!/usr/bin/env bash
# shot — screenshot → satty (annotate, then Ctrl+C to copy / Ctrl+S to save)
#
#   shot region   select an area with the mouse (default)
#   shot screen   the whole focused monitor
#   shot window   the focused window

set -o pipefail
source "$HOME/.cache/wallust/colors.sh" 2>/dev/null

tmp=$(mktemp --suffix=.png)
trap 'rm -f "$tmp"' EXIT

case ${1:-region} in
  region)
    geo=$(slurp -d -w 2 -b "${background:-#000000}66" -c "${color4:-#ffffff}ff" -s "#00000000") || exit 0
    grim -g "$geo" "$tmp" || exit 1
    ;;
  screen)
    out=$(niri msg -j focused-output | jq -r .name)
    grim -o "$out" "$tmp" || exit 1
    ;;
  window)
    # window position = output position + tile position + offset of the window in its tile
    geo=$(jq -rn \
      --argjson o "$(niri msg -j focused-output)" \
      --argjson w "$(niri msg -j focused-window)" '
      ($w.layout.tile_pos_in_workspace_view // empty) as $t
      | ($w.layout.window_offset_in_tile // [0, 0]) as $off
      | ($w.layout.window_size) as $s
      | "\(($o.logical.x + $t[0] + $off[0]) | round),\(($o.logical.y + $t[1] + $off[1]) | round) \($s[0])x\($s[1])"')
    if [[ -n $geo ]]; then
      grim -g "$geo" "$tmp" || exit 1
    else
      grim -o "$(niri msg -j focused-output | jq -r .name)" "$tmp" || exit 1
    fi
    ;;
  *)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

satty --filename "$tmp"
