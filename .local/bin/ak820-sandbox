#!/usr/bin/env bash
# ak820-sandbox — run the AK820 tool inside bubblewrap
#
#   ak820-sandbox time        sync the keyboard clock
#   ak820-sandbox <args…>     any other ak820.py command
#
# What the tool can see:
#   - the system (/usr) read-only, plus its own folder read-only
#   - ONLY the two hidraw nodes the tool needs (USB interfaces 2 and 3 of 0c45:8009)
#     -> not the interfaces that carry your keystrokes
#   - no network, an empty temporary $HOME and /tmp, nothing else of yours
#
# Edit AK820_DIR if the tool lives somewhere else.

AK820_DIR="${AK820_DIR:-$HOME/.local/share/ak820}"
VIDPID='0C45:00008009'          # HID_ID as the kernel prints it
IFACES=" 2 3 "                  # screen/command interfaces, see the project README

command -v bwrap >/dev/null || { echo "bubblewrap is missing: sudo pacman -S bubblewrap" >&2; exit 1; }
[[ -f $AK820_DIR/ak820.py ]] || { echo "ak820.py not found in $AK820_DIR" >&2; exit 1; }

nodes=()
for h in /sys/class/hidraw/hidraw*; do
  [[ -e $h ]] || continue
  grep -qi "$VIDPID" "$h/device/uevent" 2>/dev/null || continue
  n=$(cat "$h/device/../bInterfaceNumber" 2>/dev/null)
  [[ $IFACES == *" ${n#0} "* ]] || continue
  node="/dev/${h##*/}"
  nodes+=(--dev-bind "$node" "$node")
done

if ((${#nodes[@]} == 0)); then
  echo "keyboard (0c45:8009) not found - is the USB cable plugged in? (the dongle is not supported)" >&2
  exit 1
fi

exec bwrap \
  --unshare-all --die-with-parent --new-session \
  --ro-bind /usr /usr \
  --symlink usr/lib /lib --symlink usr/lib /lib64 --symlink usr/bin /bin --symlink usr/bin /sbin \
  --ro-bind /etc/ld.so.cache /etc/ld.so.cache \
  --ro-bind /sys /sys --ro-bind /etc/localtime /etc/localtime \
  --proc /proc --dev /dev \
  --tmpfs /tmp --tmpfs "$HOME" \
  --ro-bind "$AK820_DIR" "$AK820_DIR" \
  "${nodes[@]}" \
  python3 "$AK820_DIR/ak820.py" "$@"
