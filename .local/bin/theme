#!/usr/bin/env bash
unset FZF_DEFAULT_OPTS  # these pickers set their own fzf options
# theme — theme switcher for niri + wallust (fzf in a floating kitty)
#
#   theme                open the picker in a floating kitty window
#   theme tui            run the picker in the current terminal
#   theme preset <name>  apply a theme directly (then pick accents)
#   theme accent         change the two main accents
#   theme groups         change the accent of each group
#   theme apply          rewrite accent files without prompting
#   theme transparency [off|<30-99>|cycle]          see-through backgrounds
#   theme blur [off|wallpaper|behind]               blur behind them
#   theme night [off|auto|<kelvin>|restore]         night light (gammastep)
#   theme import         import extra themes from iTerm2-Color-Schemes
#
# Picker keys:  Enter = apply   Ctrl-A = accents only   Esc = close

set -o pipefail

SELF="$(realpath "$0")"
CFG="$HOME/.config/theme"
STATE_DIR="$HOME/.cache/theme"
STATE="$STATE_DIR/state"
RECENT="$CFG/recent.txt"            # most recently used themes, newest first
RECENT_MAX=10
PALETTE="$HOME/.cache/wallust/colors.sh"
PALETTE_DIR="$STATE_DIR/palettes"   # cached palettes for previews
DEFAULT_SLOT=3                      # color3 if no accent was ever chosen
ALL_LABEL="★ All themes…"
RANDOM_LABEL="random"
GROUPS_LABEL="◆ accents…"
TRANSP_PREFIX="◐ transparency:"
BLUR_PREFIX="◌ blur:"
NIGHT_PREFIX="☾ night light:"
NIGHT_LOCATION="37.98:23.73"         # Athens, for sunset / sunrise
NIGHT_DAY=6500 NIGHT_WARM=4000       # auto mode: day / night temperature
TRANSP_LEVELS=(100 95 90 85 80 75 70 60 50)   # opacity %, 100 = off
ITERM_REPO="https://github.com/mbadolato/iTerm2-Color-Schemes"
ITERM_DIR="$CFG/colorschemes/iterm2"  # imported themes live here
ACCENTS_DIR="$CFG/accents"           # accents remembered per theme


mkdir -p "$CFG" "$STATE_DIR" "$PALETTE_DIR" "$ACCENTS_DIR"

# accent groups: NIRI = windows (focus ring), WAYBAR = the bar (the main one),
# POPUP = eww popups + osd + gtk apps, LAUNCH = fuzzel + powermenu, NOTIFY = mako;
# empty POPUP / LAUNCH / NOTIFY = follow the bar
NIRI_SLOT="" WAYBAR_SLOT="" POPUP_SLOT="" LAUNCH_SLOT="" NOTIFY_SLOT="" OPACITY=100 BLUR="off" NIGHT="off" EFFECTS=""
[[ -f $STATE ]] && source "$STATE"
# older state files had a single on/off switch
if [[ $EFFECTS == on && $OPACITY == 100 ]]; then OPACITY=85 BLUR=wallpaper; fi
[[ $BLUR == on ]] && BLUR=wallpaper
# night light only counts as on while gammastep is running
[[ $NIGHT != off ]] && ! pgrep -x gammastep >/dev/null && NIGHT=off

# ───────────── helpers ─────────────

save_state() {
  {
    printf 'NIRI_SLOT=%q\n' "$NIRI_SLOT"
    printf 'WAYBAR_SLOT=%q\n' "$WAYBAR_SLOT"
    printf 'POPUP_SLOT=%q\n' "$POPUP_SLOT"
    printf 'LAUNCH_SLOT=%q\n' "$LAUNCH_SLOT"
    printf 'NOTIFY_SLOT=%q\n' "$NOTIFY_SLOT"
    printf 'OPACITY=%q\n' "$OPACITY"
    printf 'BLUR=%q\n' "$BLUR"
    printf 'NIGHT=%q\n' "$NIGHT"
  } >"$STATE"
}

# accents remembered per theme ($ACCENTS_DIR/<theme>)
theme_file() { printf '%s/%s' "$ACCENTS_DIR" "$(tr '/' '_' <<<"$1")"; }
current_theme() { cat "$STATE_DIR/current" 2>/dev/null; }

save_theme_accents() {
  local name; name=$(current_theme)
  [[ -z $name || $name == "$RANDOM_LABEL" ]] && return
  printf 'NIRI_SLOT=%q\nWAYBAR_SLOT=%q\nPOPUP_SLOT=%q\nLAUNCH_SLOT=%q\nNOTIFY_SLOT=%q\n' \
    "$NIRI_SLOT" "$WAYBAR_SLOT" "$POPUP_SLOT" "$LAUNCH_SLOT" "$NOTIFY_SLOT" >"$(theme_file "$name")"
}

# returns 1 if this theme has no saved accents yet
load_theme_accents() {
  local f; f=$(theme_file "$1")
  [[ -f $f ]] || return 1
  POPUP_SLOT="" LAUNCH_SLOT="" NOTIFY_SLOT=""
  source "$f"
}

load_palette() {
  if [[ ! -f $PALETTE ]]; then
    echo "Missing $PALETTE — apply a theme first" >&2
    exit 1
  fi
  source "$PALETTE"
}

slot_hex() { local v="color$1"; echo "${!v}"; }

transparent() { ((${OPACITY:-100} < 100)); }
blur_on() { [[ ${BLUR:-off} != off ]]; }
transp_label() {
  if transparent; then printf '%s %s%%\n' "$TRANSP_PREFIX" "$OPACITY"
  else printf '%s off\n' "$TRANSP_PREFIX"; fi
}
blur_label() { printf '%s %s\n' "$BLUR_PREFIX" "${BLUR:-off}"; }
night_label() {
  case ${NIGHT:-off} in
    off|auto) printf '%s %s\n' "$NIGHT_PREFIX" "${NIGHT:-off}" ;;
    *)        printf '%s %sK\n' "$NIGHT_PREFIX" "$NIGHT" ;;
  esac
}
# opacity as 0.85 / d9
opacity_dec() { awk -v o="${OPACITY:-100}" 'BEGIN { printf "%.2f", o / 100 }'; }
opacity_hex() { printf '%02x' $(( ${OPACITY:-100} * 255 / 100 )); }

# "#D79921" → "215;153;33"
rgb() {
  local h="${1#\#}"
  printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

fg() { printf '\e[38;2;%sm' "$(rgb "$1")"; }
bg() { printf '\e[48;2;%sm' "$(rgb "$1")"; }
RST=$'\e[0m'

picker() {
  fzf --ansi --color=16 --layout=reverse --border=none --no-sort --tiebreak=index "$@"
}

# ───────────── theme lists ─────────────

all_themes() {
  all_themes_builtin
  find "$CFG/colorschemes" -maxdepth 2 -type f -name '*.json' -printf '%f\n' 2>/dev/null |
    sed 's/\.json$//' | sort -f
}

all_themes_builtin() {
  local cache="$STATE_DIR/all-themes.txt"
  if [[ ! -s $cache ]]; then
    wallust theme --help 2>/dev/null | tr -d '\n' |
      grep -o 'possible values: [^]]*' | head -1 |
      sed 's/possible values: //' | tr ',' '\n' | sed 's/^ *//;s/ *$//' |
      grep -vxE 'random|list|list-fzf|' >"$cache"
  fi
  cat "$cache"
}

recent_themes() {
  # first run: start from the old presets list, if there is one
  if [[ ! -f $RECENT && -f $CFG/presets.txt ]]; then
    grep -vE '^\s*(#|$)' "$CFG/presets.txt" | grep -vx "$RANDOM_LABEL" |
      awk '!seen[$0]++' | head -n "$RECENT_MAX" >"$RECENT"
  fi
  [[ -f $RECENT ]] && cat "$RECENT"
}

add_recent() {
  local name="$1"
  [[ $name == "$RANDOM_LABEL" ]] && return
  {
    printf '%s\n' "$name"
    [[ -f $RECENT ]] && grep -vxF -- "$name" "$RECENT"
  } | head -n "$RECENT_MAX" >"$RECENT.tmp" && mv "$RECENT.tmp" "$RECENT"
}

custom_scheme() {
  find "$CFG/colorschemes" -maxdepth 2 -type f -name "$1.json" 2>/dev/null | head -1
}

# ───────────── palette previews ─────────────

# Generates (once) a palette file for a theme, without touching the system colors
gen_palette() {
  local name="$1" out tmp cs
  out="$PALETTE_DIR/$name.sh"
  [[ -s $out ]] && return 0
  tmp=$(mktemp -d)
  mkdir -p "$tmp/templates"
  cat >"$tmp/templates/palette.sh" <<'EOF'
background='{{background}}'
foreground='{{foreground}}'
color0='{{color0}}'
color1='{{color1}}'
color2='{{color2}}'
color3='{{color3}}'
color4='{{color4}}'
color5='{{color5}}'
color6='{{color6}}'
color7='{{color7}}'
color8='{{color8}}'
color9='{{color9}}'
color10='{{color10}}'
color11='{{color11}}'
color12='{{color12}}'
color13='{{color13}}'
color14='{{color14}}'
color15='{{color15}}'
EOF
  printf "[templates]\npalette = { template = 'palette.sh', target = '%s' }\n" "$tmp/out.sh" >"$tmp/wallust.toml"
  cs=$(custom_scheme "$name")
  if [[ -n $cs ]]; then
    wallust cs "$cs" -q -s -d "$tmp" >/dev/null 2>&1
  else
    wallust theme "$name" -q -s -d "$tmp" >/dev/null 2>&1
  fi
  [[ -s $tmp/out.sh ]] && mv "$tmp/out.sh" "$out"
  rm -rf "$tmp"
  [[ -s $out ]]
}

# One line of the fake terminal (text may contain color codes)
box_line() {
  local plain pad
  plain=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$1")
  pad=$((BOX_W - ${#plain}))
  ((pad < 0)) && pad=0
  printf '  %s  %s%*s%s\n' "$(bg "$background")" "$1$(bg "$background")" "$pad" "" "$RST"
}

cmd_preview() {
  local name="$1" i v n
  local names=(Red Green Yellow Blue Magenta Cyan White)

  if [[ $name == "$ALL_LABEL" ]]; then
    printf '\n  Browse every built-in wallust theme.\n'
    return
  fi
  if [[ $name == "$RANDOM_LABEL" ]]; then
    printf '\n  Apply a random built-in theme.\n'
    return
  fi
  if [[ $name == "$GROUPS_LABEL" ]]; then
    printf '\n  \e[1mAccent of each group\e[0m\n\n'
    printf '  windows        focus ring\n'
    printf '  bar            waybar\n'
    printf '  popups         eww, osd, gtk\n'
    printf '  launcher       fuzzel, powermenu\n'
    printf '  notifications  mako\n\n'
    printf '  Remembered per theme.\n'
    return
  fi
  if [[ $name == "$TRANSP_PREFIX"* ]]; then
    printf '\n  \e[1mTransparency, system-wide\e[0m\n\n'
    printf '  Enter opens the list of levels.\n'
    printf '  (%% = how solid the background is)\n\n'
    printf '  kitty, fuzzel, mako, waybar, eww popups\n\n'
    printf '  Currently: \e[1m%s\e[0m\n' "$(transparent && echo "$OPACITY%" || echo off)"
    return
  fi
  if [[ $name == "$NIGHT_PREFIX"* ]]; then
    printf '\n  \e[1mNight light\e[0m\n\n'
    printf '  auto    warm colors from sunset to sunrise\n'
    printf '          (Athens), changing gradually\n'
    printf '  5000K … 3500K  warm right now, lower = warmer\n\n'
    printf '  Currently: \e[1m%s\e[0m\n' "$(night_label | sed "s/^$NIGHT_PREFIX //")"
    return
  fi
  if [[ $name == "$BLUR_PREFIX"* ]]; then
    printf '\n  \e[1mBlur behind transparent windows\e[0m\n\n'
    printf '  wallpaper  only the wallpaper, blurred (light)\n'
    printf '  behind     whatever is behind, windows too\n\n'
    printf '  Only visible when transparency is on.\n\n'
    printf '  Currently: \e[1m%s\e[0m\n' "${BLUR:-off}"
    return
  fi
  if ! gen_palette "$name"; then
    printf '\n  No preview available for %s\n' "$name"
    return
  fi
  source "$PALETTE_DIR/$name.sh"

  BOX_W=$(( ${FZF_PREVIEW_COLUMNS:-60} - 8 ))
  ((BOX_W > 56)) && BOX_W=56

  local F; F=$(fg "$foreground")
  printf '\n  \e[1m%s\e[0m\n\n' "$name"

  # fake terminal
  box_line ""
  box_line "$(fg "$color2")$ ${F}ls -la"
  box_line "$(fg "$color4")config/  $(fg "$color2")build.sh  ${F}notes.md"
  box_line "$(fg "$color5")const ${F}x = $(fg "$color3")\"hello\"${F};"
  box_line "$(fg "$color1")error:${F} something failed"
  box_line "$(fg "$color3")warning:${F} check this"
  box_line "$(fg "$color6")info:${F} all good"
  box_line "$(fg "$color8")# a comment"
  box_line ""
  printf '\n'

  # 16 colors
  printf '  '
  for i in 0 1 2 3 4 5 6 7; do v="color$i"; printf '%s      %s ' "$(bg "${!v}")" "$RST"; done
  printf '\n  '
  for i in 8 9 10 11 12 13 14 15; do v="color$i"; printf '%s      %s ' "$(bg "${!v}")" "$RST"; done
  printf '\n\n'

  # accent candidates
  for i in 1 2 3 4 5 6 7; do
    v="color$i"; n="${names[i - 1]}"
    printf '  %s████%s  color%s  %-8s %s\n' "$(fg "${!v}")" "$RST" "$i" "$n" "${!v}"
  done
}

# ───────────── accents ─────────────

# Accent picker. Prints a slot number 1–7, or "follow".
#   $1 = prompt, $2 = current slot ("" = follows the bar), $3 = "follow" to offer that choice
pick_slot() {
  local names=(Red Green Yellow Blue Magenta Cyan White)
  local current="$2" i v choice cur_hex
  if [[ -z $current && $3 != follow ]]; then current=$DEFAULT_SLOT; fi
  choice=$(
    {
      if [[ -z $current ]]; then
        printf '      Keep current (follows the bar)\n'
      else
        cur_hex=$(slot_hex "$current")
        printf '%s████%s  Keep current (color%s %s)\n' "$(fg "$cur_hex")" "$RST" "$current" "$cur_hex"
      fi
      [[ $3 == follow && -n $current ]] && printf '      Follow the bar accent\n'

      for i in 1 2 3 4 5 6 7; do
        v="color$i"
        printf '%s████%s  color%s  %-8s %s\n' "$(fg "${!v}")" "$RST" "$i" "${names[i - 1]}" "${!v}"
      done
    } | picker --prompt="$1 ~> " --header="enter: select · esc: keep current"
  )
  if [[ $choice =~ Keep\ current || -z $choice ]]; then
    echo "${current:-follow}"
  elif [[ $choice =~ Follow ]]; then
    echo follow
  else
    [[ $choice =~ color([1-7]) ]] && echo "${BASH_REMATCH[1]}" || echo "$current"
  fi
}

# submenu: the accent of each group
pick_groups() {
  local choice line g slot hex desc
  while true; do
    load_palette
    choice=$(
      for g in windows bar popups launcher notifications; do
        case $g in
          windows)       slot=$NIRI_SLOT;   desc="focus ring" ;;
          bar)           slot=$WAYBAR_SLOT; desc="waybar" ;;
          popups)        slot=$POPUP_SLOT;  desc="eww, osd, gtk" ;;
          launcher)      slot=$LAUNCH_SLOT; desc="fuzzel, powermenu" ;;
          notifications) slot=$NOTIFY_SLOT; desc="mako" ;;
        esac
        if [[ -z $slot && $g != windows && $g != bar ]]; then
          hex=$(slot_hex "${WAYBAR_SLOT:-$DEFAULT_SLOT}")
          printf '%s████%s  %-14s %-13s %s\n' "$(fg "$hex")" "$RST" "$g" "follows bar" "$desc"
        else
          slot=${slot:-$DEFAULT_SLOT}; hex=$(slot_hex "$slot")
          printf '%s████%s  %-14s %-13s %s\n' "$(fg "$hex")" "$RST" "$g" "color$slot" "$desc"
        fi
      done | picker --prompt="Accents ~> " --header="enter: change · esc: back"
    ) || return 0
    case $choice in
      # popups / launcher / notifications first: their lines may say "follows bar"
      *popups*)        line=$(pick_slot "Popups accent" "$POPUP_SLOT" follow); [[ $line == follow ]] && POPUP_SLOT="" || POPUP_SLOT=$line ;;
      *launcher*)      line=$(pick_slot "Launcher accent" "$LAUNCH_SLOT" follow); [[ $line == follow ]] && LAUNCH_SLOT="" || LAUNCH_SLOT=$line ;;
      *notifications*) line=$(pick_slot "Notifications accent" "$NOTIFY_SLOT" follow); [[ $line == follow ]] && NOTIFY_SLOT="" || NOTIFY_SLOT=$line ;;
      *windows*)       NIRI_SLOT=$(pick_slot "Windows accent" "$NIRI_SLOT") ;;
      *bar*)           WAYBAR_SLOT=$(pick_slot "Bar accent" "$WAYBAR_SLOT") ;;
      *) return 0 ;;
    esac
    apply_accents; save_state; save_theme_accents; reload_all
  done
}

choose_accents() {
  load_palette
  NIRI_SLOT=$(pick_slot "Niri accent" "$NIRI_SLOT")
  WAYBAR_SLOT=$(pick_slot "Waybar accent" "$WAYBAR_SLOT")
}

# ───────────── apply ─────────────

# windows (niri)  → focus ring
# bar (waybar)     → waybar, swayosd
# popups           → eww popups + osd, gtk apps    (follows the bar if unset)
# launcher         → fuzzel launcher + powermenu   (follows the bar if unset)
# notifications    → mako                          (follows the bar if unset)
apply_accents() {
  load_palette
  local n w p l m a f
  n=$(slot_hex "${NIRI_SLOT:-$DEFAULT_SLOT}")
  w=$(slot_hex "${WAYBAR_SLOT:-$DEFAULT_SLOT}")
  p=$(slot_hex "${POPUP_SLOT:-${WAYBAR_SLOT:-$DEFAULT_SLOT}}")
  l=$(slot_hex "${LAUNCH_SLOT:-${WAYBAR_SLOT:-$DEFAULT_SLOT}}")
  m=$(slot_hex "${NOTIFY_SLOT:-${WAYBAR_SLOT:-$DEFAULT_SLOT}}")
  a=$(opacity_hex)

  cat >"$HOME/.config/niri/colors.kdl" <<EOF
layout {
    focus-ring {
        active-color "$n"
        inactive-color "$background"
    }
}
EOF

  cat >"$HOME/.config/fuzzel/colors.ini" <<EOF
[colors]
background=${background:1}${a}
text=${foreground:1}ff
match=${color14:1}ff
selection=${color8:1}55
selection-text=${l:1}ff
selection-match=${color1:1}ff
border=${l:1}d9
EOF

  {
    echo "@define-color accent $w;"
    if transparent; then
      echo "@define-color bar_bg alpha(@background, $(opacity_dec));"
    else
      echo "@define-color bar_bg @background;"
    fi
  } >"$HOME/.config/waybar/accent.css"

  if [[ -x $HOME/.config/eww/scripts/colors.sh ]]; then
    "$HOME/.config/eww/scripts/colors.sh"
    # colors.sh takes the accent of the bar; the popups group may have its own
    sed -i "s/^\$accent: .*/\$accent: $p;/" "$HOME/.config/eww/colors.scss"
    transparent && printf '$bg: rgba($bg, %s);\n' "$(opacity_dec)" >>"$HOME/.config/eww/colors.scss"
  fi

  printf 'border-color=%sFF\nprogress-color=over %sFF\nbackground-color=%s%s\n' "$m" "$m" "$background" "${a^^}" \
    >"$HOME/.config/mako/accent.conf"

  # gtk3 / gtk4 apps: accent of the popups group
  for f in "$HOME/.config/gtk-3.0/colors.css" "$HOME/.config/gtk-4.0/colors.css"; do
    [[ -f $f ]] && sed -i -E "s/^@define-color accent_(bg_)?color #[0-9A-Fa-f]+;/@define-color accent_\1color $p;/" "$f"
  done

  apply_effects
}

# transparency (kitty) + blur (niri rules)
apply_effects() {
  printf 'dynamic_background_opacity yes\nbackground_opacity %s\n' "$(opacity_dec)" \
    >"$HOME/.config/kitty/effects.conf"

  if blur_on; then
    local xray=""
    [[ $BLUR == behind ]] && xray=$'\n        xray false'
    cat >"$HOME/.config/niri/effects.kdl" <<EOF
// written by \`theme blur $BLUR\`
window-rule {
    match app-id=r#"^(kitty|com\.floating\.tui|dropdown)\$"#
    background-effect {
        blur true$xray
    }
}

layer-rule {
    match namespace=r#"^(waybar|launcher|notifications|gtk-layer-shell|eww.*)\$"#
    background-effect {
        blur true$xray
    }
}
EOF
  else
    echo '// blur off (theme blur wallpaper | behind to enable)' >"$HOME/.config/niri/effects.kdl"
  fi
}

reload_all() {
  pkill -USR2 -x waybar
  makoctl reload >/dev/null 2>&1
  pkill -USR1 -x kitty                      # kitty reloads its config
  niri msg action load-config-file >/dev/null 2>&1
  pgrep -x eww >/dev/null && eww reload >/dev/null 2>&1
  if pgrep -x swayosd-server >/dev/null; then
    pkill -x swayosd-server
    sleep 0.2
    setsid -f swayosd-server </dev/null >/dev/null 2>&1
  fi
}

finish() {
  choose_accents
  apply_accents
  save_state
  save_theme_accents
  reload_all
}

# after a theme was applied: reuse its saved accents, or ask for new ones
finish_theme() {
  if load_theme_accents "$1"; then
    apply_accents; save_state; reload_all
  else
    finish
  fi
}

apply_theme() {
  local name="$1" cs
  printf '%s\n' "$name" >"$STATE_DIR/current"   # read by neovim
  cs=$(custom_scheme "$name")
  if [[ -n $cs ]]; then
    wallust cs "$cs" -q -s >/dev/null || { echo "wallust failed with $cs" >&2; return 1; }
  else
    wallust theme "$name" -q -s >/dev/null || { echo "Theme not found: $name" >&2; return 1; }
  fi
  add_recent "$name"
}

set_transparency() {
  local v="${1:-cycle}" i
  case $v in
    off|100) OPACITY=100 ;;
    [3-9][0-9]) OPACITY=$v ;;
    cycle)
      for i in "${!TRANSP_LEVELS[@]}"; do
        if [[ ${TRANSP_LEVELS[i]} == "${OPACITY:-100}" ]]; then
          OPACITY=${TRANSP_LEVELS[(i + 1) % ${#TRANSP_LEVELS[@]}]}
          break
        fi
      done
      ;;
    *) echo "usage: theme transparency [off|<30-99>|cycle]" >&2; return 1 ;;
  esac
  save_state; apply_accents; reload_all
}

# submenu: pick a transparency level
pick_transparency() {
  local lv choice cur
  cur=${OPACITY:-100}
  choice=$(
    for lv in "${TRANSP_LEVELS[@]}"; do
      local mark="  "
      [[ $lv == "$cur" ]] && mark="● "
      if ((lv == 100)); then
        printf '%soff   solid\n' "$mark"
      else
        local bar; bar=$(printf '%*s' $(( (100 - lv) / 5 )) ''); bar=${bar// /░}
        printf '%s%s%%   %s\n' "$mark" "$lv" "$bar"
      fi
    done | picker --prompt="Transparency ~> " --header="enter: select · esc: back"
  ) || return 0
  if [[ $choice == *off* ]]; then
    set_transparency off
  elif [[ $choice =~ ([0-9]+)% ]]; then
    set_transparency "${BASH_REMATCH[1]}"
  fi
}

set_blur() {
  case "${1:-toggle}" in
    off|wallpaper|behind) BLUR=$1 ;;
    on) BLUR=wallpaper ;;
    toggle) blur_on && BLUR=off || BLUR=wallpaper ;;
    *) echo "usage: theme blur [off|wallpaper|behind]" >&2; return 1 ;;
  esac
  save_state; apply_accents; reload_all
}

# submenu: pick a blur mode
pick_blur() {
  local choice m mark
  choice=$(
    for m in off wallpaper behind; do
      mark="  "; [[ $m == "${BLUR:-off}" ]] && mark="● "
      case $m in
        off)       printf '%soff\n' "$mark" ;;
        wallpaper) printf '%swallpaper   only the wallpaper (light)\n' "$mark" ;;
        behind)    printf '%sbehind      whatever is behind, windows too\n' "$mark" ;;
      esac
    done | picker --prompt="Blur ~> " --header="enter: select · esc: back"
  ) || return 0
  for m in off wallpaper behind; do
    [[ $choice == *"$m"* ]] && { set_blur "$m"; return; }
  done
}

# night light (gammastep keeps running while it is active)
apply_night() {
  pkill -x gammastep 2>/dev/null
  sleep 0.2
  command -v gammastep >/dev/null || { [[ ${NIGHT:-off} != off ]] && echo "gammastep is not installed" >&2; return 0; }
  case ${NIGHT:-off} in
    off)  ;;
    auto) setsid -f gammastep -m wayland -l "$NIGHT_LOCATION" -t "$NIGHT_DAY:$NIGHT_WARM" >/dev/null 2>&1 ;;
    *)    setsid -f gammastep -m wayland -P -O "$NIGHT" >/dev/null 2>&1 ;;
  esac
}

set_night() {
  case "${1:-}" in
    off|auto) NIGHT=$1 ;;
    [1-9][0-9][0-9][0-9]) NIGHT=$1 ;;
    restore) apply_night; return ;;
    *) echo "usage: theme night [off|auto|<kelvin>|restore]" >&2; return 1 ;;
  esac
  save_state
  apply_night
}

# submenu: pick a night light mode
pick_night() {
  local choice m mark
  choice=$(
    for m in off auto 5000 4500 4000 3500; do
      mark="  "; [[ $m == "${NIGHT:-off}" ]] && mark="● "
      case $m in
        off)  printf '%soff\n' "$mark" ;;
        auto) printf '%sauto      warm from sunset to sunrise\n' "$mark" ;;
        5000) printf '%s5000K     slightly warm\n' "$mark" ;;
        3500) printf '%s3500K     very warm\n' "$mark" ;;
        *)    printf '%s%sK\n' "$mark" "$m" ;;
      esac
    done | picker --prompt="Night light ~> " --header="enter: select · esc: back"
  ) || return 0
  case $choice in
    *off*)  set_night off ;;
    *auto*) set_night auto ;;
    *)      [[ $choice =~ ([0-9]{4})K ]] && set_night "${BASH_REMATCH[1]}" ;;
  esac
}

# ───────────── import ─────────────

# lowercase, letters and digits only: "Gruvbox Dark" == "Gruvbox-Dark"
normalize() { iconv -f UTF-8 -t ASCII//TRANSLIT -c 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9\n'; }

# kitty .conf → pywal-style JSON that `wallust cs` understands
kitty_to_json() {
  awk '
    /^(background|foreground|cursor|color[0-9]+)[ \t]/ { v[$1] = $2 }
    END {
      if (!("background" in v) || !("foreground" in v) || !("color15" in v)) exit 1
      c = ("cursor" in v) ? v["cursor"] : v["foreground"]
      printf "{\n  \"wallpaper\": \"none\",\n  \"alpha\": \"100\",\n"
      printf "  \"special\": {\"background\": \"%s\", \"foreground\": \"%s\", \"cursor\": \"%s\"},\n", v["background"], v["foreground"], c
      printf "  \"colors\": {"
      for (i = 0; i < 16; i++) printf "%s\"color%d\": \"%s\"", (i ? ", " : ""), i, v["color" i]
      printf "}\n}\n"
    }' "$1"
}

cmd_import() {
  local repo="$STATE_DIR/iterm2-repo" f name safe added=0 skipped=0
  command -v git >/dev/null || { echo "git is required" >&2; return 1; }

  if [[ -d $repo/.git ]]; then
    echo "Updating iTerm2-Color-Schemes…"
    git -C "$repo" pull --quiet || return 1
  else
    echo "Downloading iTerm2-Color-Schemes (kitty themes only)…"
    rm -rf "$repo"
    git clone --quiet --depth 1 --filter=blob:none --sparse "$ITERM_REPO" "$repo" || return 1
    git -C "$repo" sparse-checkout set kitty || return 1
  fi

  # names wallust already has
  declare -A have=()
  rm -f "$STATE_DIR/all-themes.txt"
  while IFS= read -r name; do have[$name]=1; done < <(all_themes_builtin | normalize)

  rm -rf "$ITERM_DIR"
  mkdir -p "$ITERM_DIR"
  for f in "$repo"/kitty/*.conf; do
    name="${f##*/}"; name="${name%.conf}"
    if [[ -n ${have[$(normalize <<<"$name")]:-} ]]; then
      ((skipped++)); continue
    fi
    safe=$(tr ' ' '-' <<<"$name" | tr -cd 'A-Za-z0-9+._-')
    [[ -z $safe ]] && continue
    if kitty_to_json "$f" >"$ITERM_DIR/$safe.json"; then
      ((added++))
    else
      rm -f "$ITERM_DIR/$safe.json"
    fi
  done
  rm -rf "$PALETTE_DIR"/*
  echo "Imported $added themes ($skipped already in wallust) → $ITERM_DIR"
}

# ───────────── commands ─────────────

cmd_open() {
  exec kitty --class=com.floating.tui \
    -o remember_window_size=no -o close_on_child_death=yes \
    -o initial_window_width=130c \
    -o initial_window_height=34c \
    -e "$SELF" tui
}

cmd_tui() {
  local out key name
  while true; do
    out=$(
      {
        recent_themes
        printf '%s\n%s\n' "$ALL_LABEL" "$RANDOM_LABEL"
        printf '%s\n' "$GROUPS_LABEL"
        transp_label
        blur_label
        night_label
      } | picker \
        --prompt="Theme ~> " \
        --header="enter: apply · ctrl-a: accents only · esc: close" \
        --expect=ctrl-a \
        --preview="'$SELF' preview {}" \
        --preview-window="right,62%,border-left"
    )
    key=$(sed -n 1p <<<"$out")
    name=$(sed -n 2p <<<"$out")

    if [[ $key == ctrl-a ]]; then
      finish
      return
    fi
    [[ -z $name ]] && return 0

    # transparency / blur: change and stay in the picker
    if [[ $name == "$GROUPS_LABEL" ]]; then pick_groups; continue; fi
    if [[ $name == "$TRANSP_PREFIX"* ]]; then pick_transparency; continue; fi
    if [[ $name == "$BLUR_PREFIX"* ]]; then pick_blur; continue; fi
    if [[ $name == "$NIGHT_PREFIX"* ]]; then pick_night; continue; fi

    if [[ $name == "$ALL_LABEL" ]]; then
      name=$(
        all_themes | picker \
          --prompt="All themes ~> " \
          --header="enter: apply · esc: close" \
          --preview="'$SELF' preview {}" \
          --preview-window="right,62%,border-left"
      )
      [[ -z $name ]] && return 0
    fi

    apply_theme "$name" && finish_theme "$name"
    return
  done
}

case "${1:-}" in
  "")      cmd_open ;;
  tui)     cmd_tui ;;
  preview) cmd_preview "${2:-}" ;;
  preset)  [[ -n ${2:-} ]] && apply_theme "$2" && finish_theme "$2" ;;
  groups)  pick_groups ;;
  accent)  finish ;;
  apply)   apply_accents; reload_all ;;
  transparency) set_transparency "${2:-cycle}" ;;
  blur)    set_blur "${2:-toggle}" ;;
  night)   set_night "${2:-}" ;;
  import)  cmd_import ;;
  *)       sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
